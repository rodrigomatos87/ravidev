#!/usr/bin/env node
'use strict';
// Materializa as chaves de ~/.ravi/servers.json em ~/.ravi/keys/ e remove as órfãs. Idempotente.
//   - s.key (LEGADO, chat/sandbox): chave PRIVADA em keys/<id> (chmod 600).
//   - s.pub (IDE, modo agente): só a chave PÚBLICA em keys/<id>.pub — a privada fica no HOST
//     (ssh-agent montado em ~/.ravi-ssh); o .pub serve de pin (IdentitiesOnly) no ravi-ssh/SFTP.
const fs = require('fs'), path = require('path');
const home = process.env.HOME || '/root';
const sf = path.join(home, '.ravi', 'servers.json');
const dir = path.join(home, '.ravi', 'keys');
let a = [];
try { a = JSON.parse(fs.readFileSync(sf, 'utf8')); } catch (e) { a = []; }
try { fs.mkdirSync(dir, { recursive: true }); fs.chmodSync(dir, 0o700); } catch (e) {}
const keep = new Set();
for (const s of a) {
    if (!s || s.auth !== 'key') continue;
    const id = String(s.id != null ? s.id : s.name);
    if (s.key) {
        keep.add(id);
        try { fs.writeFileSync(path.join(dir, id), s.key.endsWith('\n') ? s.key : s.key + '\n', { mode: 0o600 }); fs.chmodSync(path.join(dir, id), 0o600); } catch (e) {}
    }
    if (s.pub) {
        keep.add(id + '.pub');
        try { fs.writeFileSync(path.join(dir, id + '.pub'), s.pub.endsWith('\n') ? s.pub : s.pub + '\n', { mode: 0o644 }); } catch (e) {}
    }
}
try { for (const f of fs.readdirSync(dir)) { if (!keep.has(f)) try { fs.unlinkSync(path.join(dir, f)); } catch (e) {} } } catch (e) {}
