#!/usr/bin/env bash
# Regera o snippet do nginx com uma rota /p/<token>/ por preview ativo a partir de
# storage/previews-nginx.json, que o PreviewService escreve. Chamado via PREVIEW_NGINX_TRIGGER.
# Instalado em /usr/local/bin/ravi-preview-nginx por bin/instalar-modelos.sh (__RAIZ__ = pasta da instalação).
set -euo pipefail
RAIZ=__RAIZ__
DATA=$RAIZ/storage/previews-nginx.json
OUT=/etc/nginx/snippets/ravi-previews.conf
BAK=/etc/nginx/snippets/ravi-previews.conf.bak
[ -f "$DATA" ] || echo "[]" > "$DATA"
[ -f "$OUT" ] && cp "$OUT" "$BAK" || true
php -r '
$d = json_decode(@file_get_contents($argv[1]), true) ?: [];
$o = "";
foreach ($d as $p) {
  $t = preg_replace("/[^a-f0-9]/", "", (string)($p["token"] ?? ""));
  $port = (int)($p["port"] ?? 0);
  if ($t === "" || $port < 21000 || $port > 21099) continue;
  $o .= "location ^~ /p/$t/ {\n";
  $o .= "    proxy_pass http://127.0.0.1:$port/;\n";
  $o .= "    proxy_http_version 1.1;\n";
  $o .= "    proxy_set_header Host \$host;\n";
  $o .= "    proxy_set_header X-Real-IP \$remote_addr;\n";
  $o .= "    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;\n";
  $o .= "    proxy_set_header X-Forwarded-Proto \$scheme;\n";
  $o .= "    proxy_set_header X-Forwarded-Prefix /p/$t;\n";
  $o .= "    proxy_redirect / /p/$t/;\n";
  $o .= "    proxy_cookie_path / /p/$t/;\n";
  $o .= "}\n";
}
file_put_contents($argv[2], $o);
' "$DATA" "$OUT"
if nginx -t 2>/dev/null; then
  systemctl reload nginx
else
  [ -f "$BAK" ] && cp "$BAK" "$OUT" || : > "$OUT"
  echo "nginx -t falhou; snippet anterior restaurado" >&2
  exit 1
fi
