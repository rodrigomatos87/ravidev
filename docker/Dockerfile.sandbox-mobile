# Sandbox MOBILE: React Native + Expo + Android SDK por cima da imagem base.
# Usada só em projetos do tipo "app". Node já vem da base; aqui add JDK + Android SDK + Expo/EAS.
# (iOS é buildado no nó macOS/iMac, não aqui.)
FROM ravi-sandbox:latest

USER root
ENV DEBIAN_FRONTEND=noninteractive

# JDK 17 (Android/Gradle) + utilitários
RUN apt-get update && apt-get install -y \
    openjdk-17-jdk-headless \
    unzip xz-utils \
    && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# ── Android SDK (command line tools) — para build de APK/AAB no Linux ───────
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV ANDROID_HOME=/opt/android-sdk
RUN mkdir -p ${ANDROID_SDK_ROOT}/cmdline-tools && cd /tmp && \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -O cmdtools.zip && \
    unzip -q cmdtools.zip -d ${ANDROID_SDK_ROOT}/cmdline-tools && \
    mv ${ANDROID_SDK_ROOT}/cmdline-tools/cmdline-tools ${ANDROID_SDK_ROOT}/cmdline-tools/latest && \
    rm cmdtools.zip
ENV PATH="${PATH}:${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin:${ANDROID_SDK_ROOT}/platform-tools"
RUN yes | sdkmanager --licenses >/dev/null 2>&1 || true && \
    sdkmanager "platform-tools" \
               "platforms;android-35" "build-tools;35.0.0" \
               "platforms;android-34" "build-tools;34.0.0" >/dev/null

# ── Expo / EAS / RN tooling (npm global) ───────────────────────────────────
# create-expo-app e o CLI do expo rodam via npx no projeto; eas-cli global p/ build/submit.
RUN npm install -g eas-cli @expo/ngrok 2>/dev/null || true

# Permissões: SDK + home do sandbox (npm/gradle/expo escrevem caches em $HOME)
RUN mkdir -p /home/sandbox/.npm /home/sandbox/.gradle && \
    chown -R sandbox:sandbox ${ANDROID_SDK_ROOT} /home/sandbox

USER sandbox
WORKDIR /workspace
ENV PATH="${PATH}:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools"

CMD ["tail", "-f", "/dev/null"]
