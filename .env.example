# =============================================================================
# RaviDeveloper: configuração de ambiente
# =============================================================================
# Copie para .env e preencha. Valores abaixo são o PADRÃO do código ou um
# placeholder; nada aqui é valor real. Chave comentada (#CHAVE=) = opcional,
# o código usa o padrão indicado quando ela não existe.
#
# Obrigatórias na subida (sem elas o sistema responde 500 genérico e grava o
# motivo no log): APP_KEY, DB_HOST, DB_DATABASE, DB_USERNAME.
# =============================================================================

# ── Aplicação ────────────────────────────────────────────────────────────────
# Nome exibido na interface e nos e-mails.
APP_NAME="Ravi Developer"
# production | development. Em production o cookie de sessão sai com Secure.
APP_ENV=production
# true mostra erro detalhado na tela. Nunca true em produção.
APP_DEBUG=false
# URL pública do painel, sem barra no fim. Base de links de e-mail, OAuth do
# GitHub e da URL do WebSocket quando WEBSOCKET_URL estiver vazia.
APP_URL=https://seu-dominio.com.br
# Chave mestra de criptografia (licenças, tokens GitHub, SMTP, 2FA, chaves SSH).
# Mínimo 32 bytes. Gere com: openssl rand -base64 32
# TROCAR a chave deixa indecifrável tudo que já está cifrado no banco.
APP_KEY=
# Nome alternativo aceito para a mesma chave. Use só APP_KEY; se as duas
# existirem com valores diferentes o sistema recusa subir.
#ENCRYPTION_KEY=
# Fuso horário do PHP.
APP_TIMEZONE=America/Sao_Paulo

# ── Banco de dados ───────────────────────────────────────────────────────────
# Driver: mysql (MariaDB/MySQL) ou pgsql.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ravi_developer
DB_USERNAME=ravi
# Pode ficar vazia só em desenvolvimento.
DB_PASSWORD=

# ── Logs ─────────────────────────────────────────────────────────────────────
# debug | info | warning | error | critical (padrão do código: debug).
LOG_LEVEL=error
# daily (um arquivo por dia) | single (arquivo único). Padrão: daily.
LOG_CHANNEL=daily

# ── Claude API (agentes do chat) ─────────────────────────────────────────────
# Chave padrão da Anthropic quando o usuário não tem a própria (sk-ant-...).
CLAUDE_API_KEY=
# Modelo padrão das chamadas pela API.
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=16000
CLAUDE_TEMPERATURE=0.7
# Máximo de iterações do loop de ferramentas por pedido.
MAX_AGENT_ITERATIONS=50
# Preço por milhão de tokens (US$) e multiplicadores de cache, usados só no
# cálculo de custo exibido no painel.
CLAUDE_PRICE_INPUT=15.0
CLAUDE_PRICE_OUTPUT=75.0
CLAUDE_PRICE_CACHE_WRITE_MULT=1.25
CLAUDE_PRICE_CACHE_READ_MULT=0.10

# ── Claude Code (CLI dentro do sandbox) ──────────────────────────────────────
# true: o worker roda o Claude Code no container do projeto em vez do loop próprio.
CLAUDE_CODE_ENABLED=false
# Modelo do Claude Code quando o usuário não escolhe outro no seletor.
CLAUDE_CODE_MODEL=claude-opus-5
# Tempo máximo de uma execução (s).
CLAUDE_CODE_TIMEOUT=1800
# Sem saída nenhuma por este tempo (s) = execução travada, é encerrada.
CLAUDE_CODE_STALL_TIMEOUT=720
# Limites de cada container de especialista rodando em paralelo.
CLAUDE_CODE_PARALLEL_MEMORY=1g
CLAUDE_CODE_PARALLEL_CPU=1
# Grava o prompt que cada agente recebe, para auditoria (padrão: true).
CLAUDE_CODE_DEBUG_PROMPTS=false
# LEGADO, deixe VAZIO. As licenças vivem cifradas no banco (Admin > Licenças) e
# este token nunca entra na resolução; só serve de semente no primeiro acesso.
CLAUDE_CODE_OAUTH_TOKEN=
# Especialistas em paralelo por onda e intervalo entre os disparos (ms).
SPECIALISTS_MAX_PARALLEL=10
SPECIALISTS_LAUNCH_STAGGER_MS=3000

# ── Maestro (desenvolvimento autônomo) ───────────────────────────────────────
# true: o worker usa plano > aprovação > loop autônomo com portões até a entrega.
MAESTRO_ENABLED=false
# Tentativas por portão antes de desistir.
MAESTRO_MAX_ATTEMPTS=3
# Máximo de ondas de especialistas por tarefa.
MAESTRO_MAX_WAVES=10
# QA visual (navegador no sandbox) antes da entrega, e quantas rodadas.
MAESTRO_QA_VISUAL=true
MAESTRO_QA_VISUAL_ROUNDS=2
# Porta do app sob teste no sandbox, tempo máximo (s) e quadros por segundo da gravação.
QA_VISUAL_PORT=8080
QA_VISUAL_TIMEOUT=240
QA_VISUAL_FPS=4

# ── Gateway de API (front isolado em gateway-public/) ────────────────────────
# URL pública do gateway, exibida no painel admin.
GW_PUBLIC_URL=https://api.seu-dominio.com.br
# Backend padrão = Claude Code CLI. true liga o proxy fino para a Messages API;
# erro/429 do proxy cai no CLI, nunca vai ao cliente.
GW_PROXY_ENABLED=false
GW_ANTHROPIC_BASE=https://api.anthropic.com
# Cabeçalho anthropic-beta da autenticação OAuth.
GW_OAUTH_BETA=oauth-2025-04-20
# Timeout (s) do proxy HTTP para a Anthropic.
GW_HTTP_TIMEOUT=120
# Timeout (s) de cada tentativa no CLI quando o cliente não pede outro (padrão do código: 50).
GW_MAX_TIMEOUT=110
# Orçamento (s) de parede para ainda iniciar nova tentativa no failover.
GW_FAILOVER_BUDGET=100
# Modelo de reserva quando o pedido falha no modelo original.
GW_FALLBACK_MODEL=claude-sonnet-5
# Containers CLI simultâneos no host (cerca de 1 GB cada; teto contra OOM).
GW_MAX_CONCURRENCY=6
# Espera (s) por uma vaga antes de responder 529 overloaded.
GW_SLOT_WAIT=15
# Chamada longa (cabeçalho x-ravi-tempo-limite): teto em s e vagas próprias.
# O nginx do vhost do gateway precisa de fastcgi_read_timeout acima do teto.
GW_TEMPO_TETO=600
GW_LONGAS_MAX=2
# Executor de modelos OpenAI (Codex CLI): imagem e timeout (s).
GW_CODEX_IMAGE=ravi-codex:latest
GW_CODEX_TIMEOUT=90

# ── Sandbox Docker ───────────────────────────────────────────────────────────
SANDBOX_IMAGE=ravi-sandbox:latest
# Imagem dos projetos mobile (Android/Expo).
SANDBOX_IMAGE_MOBILE=ravi-sandbox-mobile:latest
# Tempo máximo de um comando no sandbox (s).
SANDBOX_TIMEOUT=1800
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPU_LIMIT=2
# Limites do container de build de APK.
APK_BUILD_MEMORY=10g
APK_BUILD_CPU=4
# Tempo (s) que o túnel do Expo Go fica vivo.
EXPO_GO_TTL=3600

# ── Preview dos projetos (/p/<token>/) ───────────────────────────────────────
# Vazia = APP_URL/p.
PREVIEW_BASE_URL=https://seu-dominio.com.br/p
# Container e rede do banco compartilhado dos previews.
PREVIEW_DB_HOST=ravi-preview-db
PREVIEW_DB_ROOT_PASS=
PREVIEW_NET=ravi-preview-net
# Faixa de portas no host para os previews.
PREVIEW_PORT_MIN=21000
PREVIEW_PORT_MAX=21099
# Comando (via sudo) que regrava o nginx dos previews.
PREVIEW_NGINX_TRIGGER="sudo /usr/local/bin/ravi-preview-nginx"
# Minutos ociosos até bin/cleanup-previews.php derrubar o preview.
PREVIEW_IDLE_MINUTES=60

# ── IDE (code-server por projeto, /ide/<token>/) ─────────────────────────────
# Vazia = APP_URL/ide.
IDE_BASE_URL=https://seu-dominio.com.br/ide
IDE_IMAGE=ravi-ide:latest
# Padrão de recursos por IDE (o painel Configurações pode sobrescrever).
IDE_MEMORY=2g
IDE_CPU=2
# Faixa de portas no host para as IDEs.
IDE_PORT_MIN=21100
IDE_PORT_MAX=21199
# Comando (via sudo) que regrava o nginx das IDEs.
IDE_NGINX_TRIGGER="sudo /usr/local/bin/ravi-ide-nginx"
# bin/cleanup-ides.php: minutos ociosos até parar e dias até remover.
IDE_IDLE_MINUTES=120
IDE_REAP_DAYS=7
# Pasta no host dos ssh-agent por container (a chave nunca entra no container).
IDE_SSH_AGENT_DIR=/var/lib/ravi/ide-ssh
# Proxies no host vistos de dentro dos containers (docker0).
IDE_PROXY_URL=http://172.17.0.1:8788
GIT_PROXY_URL=http://172.17.0.1:8789

# ── WebSocket (bin/websocket-server.php) ─────────────────────────────────────
# Endereço e porta onde o servidor escuta (127.0.0.1 atrás do nginx).
WEBSOCKET_HOST=127.0.0.1
WEBSOCKET_PORT=8081
# URL que o NAVEGADOR usa. Vazia = derivada do APP_URL
# (https vira wss://<host>/ws; http vira ws://<host>:WEBSOCKET_PORT).
WEBSOCKET_URL=wss://seu-dominio.com.br/ws

# ── E-mail SMTP (reset de senha, 2FA, avisos) ────────────────────────────────
# Valores salvos em Configurações no painel têm prioridade sobre estes.
MAIL_HOST=smtp.seu-provedor.com
# 587 com tls, 465 com ssl.
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
# Vazio = noreply@<host do APP_URL>.
MAIL_FROM_ADDRESS=noreply@seu-dominio.com.br
MAIL_FROM_NAME="Ravi Developer"

# ── GitHub (OAuth App e webhook) ─────────────────────────────────────────────
# Callback do OAuth App: <APP_URL>/settings/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Escopo pedido no OAuth; repo cobre repositórios privados.
GITHUB_SCOPE=repo
# Segredo de assinatura do webhook do GitHub (vazio = webhook recusado).
GITHUB_WEBHOOK_SECRET=

# ── Busca na web (ferramenta web_search) ─────────────────────────────────────
# duckduckgo (gratuito) | serpapi (exige SERPAPI_KEY).
SEARCH_PROVIDER=duckduckgo
SERPAPI_KEY=

# ── Módulo ionCube (modulos/ioncube, opcional) ───────────────────────────────
# Proxy do encoder no host, visto de dentro das IDEs.
IONCUBE_PROXY_URL=http://172.17.0.1:8790

# ── Módulo VPN de suporte (modulos/vpn, opcional) ────────────────────────────
# SHA-256 (hex) do token que o cliente manda em X-Vpn-Token. Vazio = API fechada.
VPN_API_TOKEN_HASH=
# Segredo do HMAC-SHA256 que assina toda resposta (cabeçalho X-Vpn-Assinatura).
VPN_API_ASSINATURA=
# IPs autorizados, separados por vírgula. Vazio = só o token decide.
VPN_API_ALLOW_IPS=

# =============================================================================
# Proxies em Python (bin/ide-proxy.py, bin/git-proxy.py,
# modulos/ioncube/bin/ioncube-proxy.py). NÃO leem este arquivo: recebem as
# variáveis pelo ambiente do serviço systemd (Environment=). Referência dos
# nomes e padrões:
# =============================================================================
#IDE_PROXY_LISTEN=172.17.0.1
#IDE_PROXY_PORT=8788
# Os RESOLVER têm como padrão o arquivo ao lado do próprio script.
#IDE_PROXY_RESOLVER=/caminho/do/app/bin/ide-proxy-token.php
#IDE_PROXY_PHP=php
#IDE_PROXY_UPSTREAM=api.anthropic.com
#IDE_PROXY_CACHE_TTL=45
#IDE_PROXY_BLOCK_TTL=30
#IDE_PROXY_OBSERVED=/caminho/do/app/storage/cache/license-usage-observed.json
#GIT_PROXY_LISTEN=172.17.0.1
#GIT_PROXY_PORT=8789
#GIT_PROXY_RESOLVER=/caminho/do/app/bin/git-proxy-token.php
#GIT_PROXY_PHP=php
#GIT_PROXY_UPSTREAM=github.com
#GIT_PROXY_CACHE_TTL=30
#GIT_PROXY_MAX_BODY=1073741824
#IONCUBE_PROXY_LISTEN=172.17.0.1
#IONCUBE_PROXY_PORT=8790
#IONCUBE_PROXY_RESOLVER=/caminho/do/app/modulos/ioncube/bin/ioncube-proxy-token.php
#IONCUBE_PROXY_PHP=php
#IONCUBE_ENCODER_BIN=/usr/local/bin/ioncube_encoder.sh
#IONCUBE_PROXY_CACHE_TTL=30
#IONCUBE_PROXY_MAX_BODY=10485760
#IONCUBE_ENCODE_TIMEOUT=120
#IONCUBE_ENCODE_DIR_TIMEOUT=900
#IONCUBE_ENCODE_RETRIES=4
#IONCUBE_ENCODE_RETRY_PAUSE=0.3
